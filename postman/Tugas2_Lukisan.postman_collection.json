          "name": "Tambah lukisan baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Status respons bernilai success\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(\"success\");",
                  "  pm.expect(b.message).to.eql(\"Data berhasil ditambahkan\");",
                  "});",
                  "pm.test(\"Data lukisan baru memiliki id berupa angka\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.data).to.be.an(\"object\");",
                  "  pm.expect(b.data.id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Judul dan pelukis lukisan baru sesuai\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.data.judul).to.eql(\"Lukisan Uji Otomasi\");",
                  "  pm.expect(b.data.pelukis).to.eql(\"M. Rizki Algipari\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"paintingId\", pm.response.json().data.id);",
                  "}"
                ]
              }
            }
