        {
          "name": "Info API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respons berupa objek informasi API\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.be.an(\"object\");",
                  "  pm.expect(b).to.have.property(\"nama\");",
                  "  pm.expect(b).to.have.property(\"nim\");",
                  "  pm.expect(b).to.have.property(\"endpoints\").that.is.an(\"array\");",
                  "});",
                  "pm.test(\"Identitas dan resource sesuai\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.nama).to.eql(\"M. Rizki Algipari\");",
                  "  pm.expect(b.nim).to.eql(\"2428240069\");",
                  "  pm.expect(b.resource).to.eql(\"/paintings\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          },
          "response": []
        },
        {
          "name": "Ambil semua lukisan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respons berupa array\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Minimal berisi tiga lukisan awal\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.length).to.be.at.least(3);",
                  "});",
                  "pm.test(\"Setiap lukisan memiliki field wajib\", () => {",
                  "  const b = pm.response.json();",
                  "  b.forEach((lukisan) => {",
                  "    pm.expect(lukisan).to.have.all.keys(\"id\", \"judul\", \"pelukis\", \"aliran\", \"tahunDibuat\", \"harga\");",
                  "  });",
                  "});"
                ]
