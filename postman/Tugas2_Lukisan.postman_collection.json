                  "  pm.expect(b.status).to.eql(\"success\");",
                  "});",
                  "pm.test(\"Lukisan yang diperbarui adalah paintingId yang disimpan\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.data.id).to.eql(Number(pm.environment.get(\"paintingId\")));",
                  "});",
                  "pm.test(\"Judul dan harga lukisan berhasil diperbarui\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.data.judul).to.eql(\"Lukisan Uji Otomasi (Diperbarui)\");",
                  "  pm.expect(b.data.harga).to.eql(5000000);",
                  "});",
                  "pm.test(\"Pesan menyebut id lukisan yang diperbarui\", () => {",
                  "  const b = pm.response.json();",
                  "  const id = pm.environment.get(\"paintingId\");",
                  "  pm.expect(b.message).to.eql(`Data lukisan dengan id ${id} berhasil diperbarui`);",
                  "});"
                ]
